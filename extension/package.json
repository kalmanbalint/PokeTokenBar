{
  "name": "poketokenbar",
  "displayName": "PokeTokenBar",
  "description": "AI coding tool usage in your status bar",
  "version": "0.4.1",
  "publisher": "kalmanbalint",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalmanbalint/PokeTokenBar.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The usage helper process is started only in trusted workspaces, since an untrusted folder can contribute configuration."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "poketokenbar.showCompanion",
        "title": "PokeTokenBar: Show companion"
      },
      {
        "command": "poketokenbar.refresh",
        "title": "PokeTokenBar: Refresh usage"
      },
      {
        "command": "poketokenbar.showDiagnostics",
        "title": "PokeTokenBar: Show scan diagnostics"
      }
    ],
    "configuration": {
      "title": "PokeTokenBar",
      "properties": {
        "poketokenbar.refreshIntervalSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "maximum": 3600,
          "scope": "window",
          "markdownDescription": "How often to refresh usage. There is deliberately **no setting for the helper executable path**: a folder you open can contribute configuration, so such a setting would let a repository choose what this extension runs."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "poketokenbar",
          "title": "PokeTokenBar",
          "icon": "media/companion.svg"
        }
      ]
    },
    "views": {
      "poketokenbar": [
        {
          "type": "webview",
          "id": "poketokenbar.companion",
          "name": "Companion"
        }
      ]
    }
  },
  "scripts": {
    "build:sidecar": "dotnet build -c Release ../dotnet/PokeTokenBar.slnx",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "copy-sidecar": "node scripts/copy-sidecar.mjs",
    "dev": "npm run copy-sidecar && npm run compile",
    "build:all": "npm run build:sidecar && npm run dev",
    "test": "npm run compile && node --test test/*.test.mjs",
    "test:all": "npm run build:sidecar && dotnet test ../dotnet/PokeTokenBar.slnx && npm test",
    "package": "node scripts/package-vsix.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.7.2"
  }
}
